[gd_scene load_steps=1 format=3]
[node name="Decks" type="VBoxContainer"]
theme_override_constants/separation = 16
size_flags_horizontal = 3

[node name="Title" type="Label" parent="."]
mouse_filter = 2
text = "Shape your strategy"
theme_override_font_sizes/font_size = 38
autowrap_mode = 3

[node name="Selector" type="OptionButton" parent="."]
custom_minimum_size = Vector2(0, 64)

[node name="Tools" type="HBoxContainer" parent="."]
theme_override_constants/separation = 12

[node name="New" type="Button" parent="Tools"]
text = "New deck"
custom_minimum_size = Vector2(0, 64)
size_flags_horizontal = 3

[node name="Save" type="Button" parent="Tools"]
text = "Save deck"
custom_minimum_size = Vector2(0, 64)
size_flags_horizontal = 3

[node name="Name" type="LineEdit" parent="."]
placeholder_text = "Deck name"
custom_minimum_size = Vector2(0, 60)

[node name="Validation" type="Label" parent="."]
mouse_filter = 2
text = "20 / 20 cards"
theme_override_font_sizes/font_size = 20
autowrap_mode = 3

[node name="Hint" type="Label" parent="."]
mouse_filter = 2
text = "Tap + to add an owned card, − to remove it. Tap its name to inspect."
theme_override_font_sizes/font_size = 18
autowrap_mode = 3

[node name="Rows" type="VBoxContainer" parent="."]
theme_override_constants/separation = 8
