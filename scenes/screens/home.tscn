[gd_scene load_steps=1 format=3]
[node name="Home" type="VBoxContainer"]
theme_override_constants/separation = 16
size_flags_horizontal = 3

[node name="Eyebrow" type="Label" parent="."]
mouse_filter = 2
text = "THE SKYBOUND COLLECTION"
theme_override_font_sizes/font_size = 17
autowrap_mode = 3

[node name="Title" type="Label" parent="."]
mouse_filter = 2
text = "A little wonder.\nA wild new world."
theme_override_font_sizes/font_size = 48
autowrap_mode = 3

[node name="Hero" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(0, 380)

[node name="Art" type="TextureRect" parent="Hero"]
expand_mode = 1
stretch_mode = 6
mouse_filter = 2

[node name="Shade" type="ColorRect" parent="Hero"]
color = Color(0.06, 0.09, 0.22, 0.38)
mouse_filter = 2

[node name="Overlay" type="VBoxContainer" parent="Hero"]
alignment = 2
theme_override_constants/separation = 5

[node name="Tag" type="Label" parent="Hero/Overlay"]
mouse_filter = 2
text = "  FIRST LIGHT  /  48 CARDS"
theme_override_font_sizes/font_size = 18
autowrap_mode = 3
theme_override_colors/font_color = Color(1, 0.9, 0.65, 1)

[node name="Name" type="Label" parent="Hero/Overlay"]
mouse_filter = 2
text = "  Guardians of the Wild"
theme_override_font_sizes/font_size = 32
autowrap_mode = 3
theme_override_colors/font_color = Color(1, 1, 1, 1)

[node name="Stats" type="Label" parent="."]
mouse_filter = 2
text = "0 / 48 discovered  ·  0 coins"
theme_override_font_sizes/font_size = 22
autowrap_mode = 3

[node name="StarterTitle" type="Label" parent="."]
mouse_filter = 2
text = "Choose your first guardians"
theme_override_font_sizes/font_size = 28
autowrap_mode = 3

[node name="StarterNote" type="Label" parent="."]
mouse_filter = 2
text = "Your starter deck is ready to play. Every guardian can use universal energy."
theme_override_font_sizes/font_size = 20
autowrap_mode = 3

[node name="Starters" type="HBoxContainer" parent="."]
theme_override_constants/separation = 12

[node name="Flame" type="Button" parent="Starters"]
text = "Flame"
custom_minimum_size = Vector2(0, 64)
size_flags_horizontal = 3

[node name="Tide" type="Button" parent="Starters"]
text = "Tide"
custom_minimum_size = Vector2(0, 64)
size_flags_horizontal = 3

[node name="Gale" type="Button" parent="Starters"]
text = "Gale"
custom_minimum_size = Vector2(0, 64)
size_flags_horizontal = 3

[node name="Packs" type="Button" parent="."]
text = "Open a pack  →"
custom_minimum_size = Vector2(0, 64)

[node name="Battle" type="Button" parent="."]
text = "Enter the arena  →"
custom_minimum_size = Vector2(0, 64)

[node name="Resume" type="Button" parent="."]
text = "Resume battle  →"
custom_minimum_size = Vector2(0, 64)

[node name="Hint" type="Label" parent="."]
mouse_filter = 2
text = "Collect 12, 24, 36 and 48 unique cards to earn bonus packs."
theme_override_font_sizes/font_size = 19
autowrap_mode = 3
