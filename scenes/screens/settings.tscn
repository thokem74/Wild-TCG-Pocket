[node name="Rules" type="Label" parent="."]
mouse_filter = 2
text = "HOW TO PLAY\n\nDeploy creatures from your hand onto your bench. Tap a guardian to attach your one energy orb each turn. Attacking ends your turn; energy stays attached.\n\nUse one support and retreat once per turn. Retreat discards the active creature’s listed energy cost.\n\nKnockouts score one point. Choose a replacement from your bench after a knockout. Reach three points to win.\n\nThe first player skips their first draw, energy and attack. Failing to draw loses; 60 turns is a draw."
theme_override_font_sizes/font_size = 22
autowrap_mode = 3

[node name="About" type="Label" parent="."]
mouse_filter = 2
text = "WILD TCG POCKET • FIRST LIGHT\nOriginal creatures. Offline adventures.\nProgress is saved on this device."
theme_override_font_sizes/font_size = 18
autowrap_mode = 3
